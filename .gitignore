-- Hit marker + bullet trace helpers
local hitMarkerGui, hitMarkerLine1, hitMarkerLine2
local function showHitMarker()
	pcall(function()
		if not hitMarkerGui or not hitMarkerGui.Parent then
			hitMarkerGui = Instance.new("ScreenGui")
			hitMarkerGui.Name = "CombatHub_HitMarker"
			hitMarkerGui.IgnoreGuiInset = true
			hitMarkerGui.ResetOnSpawn = false
			hitMarkerGui.DisplayOrder = 1000
			hitMarkerGui.Parent = Gui.Parent
			local function mk()
				local f = Instance.new("Frame")
				f.BorderSizePixel = 0
				f.BackgroundColor3 = Color3.fromRGB(255,255,255)
				f.AnchorPoint = Vector2.new(0.5,0.5)
				f.Parent = hitMarkerGui
				return f
			end
			hitMarkerLine1 = mk()
			hitMarkerLine2 = mk()
		end
		local size = S.HitMarkerSize or 18
		local cam = workspace.CurrentCamera
		local c = cam and cam.ViewportSize/2 or Vector2.new(400,300)
		hitMarkerLine1.Size = UDim2.fromOffset(size, 2)
		hitMarkerLine2.Size = UDim2.fromOffset(size, 2)
		hitMarkerLine1.Position = UDim2.fromOffset(c.X, c.Y)
		hitMarkerLine2.Position = UDim2.fromOffset(c.X, c.Y)
		hitMarkerLine1.Rotation = 45
		hitMarkerLine2.Rotation = -45
		hitMarkerLine1.Visible = true
		hitMarkerLine2.Visible = true
		local life = S.HitMarkerTime or 0.12
		task.delay(life, function()
			if hitMarkerLine1 then hitMarkerLine1.Visible = false end
			if hitMarkerLine2 then hitMarkerLine2.Visible = false end
		end)
	end)
end

local activeTraces = {}
local function showBulletTrace(worldPos)
	pcall(function()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local att0 = Instance.new("Attachment")
		local att1 = Instance.new("Attachment")
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.Transparency = 1
		part.Size = Vector3.new(0.1,0.1,0.1)
		part.CFrame = CFrame.new(cam.CFrame.Position)
		part.Parent = workspace
		att0.Parent = part
		att1.WorldPosition = worldPos
		att1.Parent = part
		local beam = Instance.new("Beam")
		beam.Attachment0 = att0
		beam.Attachment1 = att1
		beam.Width0 = 0.15
		beam.Width1 = 0.05
		beam.Color = ColorSequence.new(S.ESPColor or Color3.fromRGB(255,60,80))
		beam.FaceCamera = true
		beam.Parent = part
		table.insert(activeTraces, part)
		task.delay(S.BulletTraceTime or 0.15, function()
			pcall(function() part:Destroy() end)
		end)
	end)
end

-- Auto reload best-effort
local lastReload = 0
local function tryAutoReload()
	if not S.AutoReload or S.Panic then return end
	if tick() - lastReload < 0.4 then return end
	local char = LP.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if not tool then return end
	local need = false
	for _, v in ipairs(tool:GetDescendants()) do
		if v:IsA("IntValue") or v:IsA("NumberValue") then
			local n = v.Name:lower()
			if (n:find("ammo",1,true) or n:find("clip",1,true) or n:find("mag",1,true)) and v.Value <= 0 then
				need = true
				break
			end
		end
	end
	if need then
		lastReload = tick()
		pcall(function()
			if VIM then
				VIM:SendKeyEvent(true, S.AutoReloadKey or Enum.KeyCode.R, false, game)
				task.delay(0.05, function()
					pcall(function() VIM:SendKeyEvent(false, S.AutoReloadKey or Enum.KeyCode.R, false, game) end)
				end)
			end
		end)
	end
end


-- Auto crouch + stop move while shooting
local crouchHeld = false
local function updateShootStance()
	if S.Panic or not running then
		if crouchHeld then
			pcall(function()
				if VIM then VIM:SendKeyEvent(false, S.CrouchKey or Enum.KeyCode.LeftShift, false, game) end
			end)
			crouchHeld = false
		end
		return
	end
	local shooting = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	local char = LP.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if S.AutoCrouchShoot and shooting then
		if not crouchHeld then
			pcall(function()
				if VIM then VIM:SendKeyEvent(true, S.CrouchKey or Enum.KeyCode.LeftShift, false, game) end
			end)
			crouchHeld = true
		end
		if hum then
			pcall(function() hum.Crouching = true end)
		end
	elseif crouchHeld then
		pcall(function()
			if VIM then VIM:SendKeyEvent(false, S.CrouchKey or Enum.KeyCode.LeftShift, false, game) end
		end)
		crouchHeld = false
	end
	if S.StopMoveShoot and shooting and hum then
		hum:Move(Vector3.zero, false)
		if S.StopMoveStrict and hrp then
			local v = hrp.AssemblyLinearVelocity
			hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
		end
		if hum then
			setProperty("StopMoveShoot", hum, "WalkSpeed", 0)
		end
	elseif not shooting then
		restoreModule("StopMoveShoot")
	end
end


-- Grenade auto-calibrate: sample a real thrown projectile and fit gravity/speed
local calibrating = false
local calibConn = nil
local calibSamples = {}
local calibStart = 0

local function setCalibText(t, ok)
	local lab = rawget(_G, "CombatHubCalibLabel")
	if lab then
		lab.Text = t
		lab.TextColor3 = ok==true and T.ok or (ok==false and T.bad or T.dim)
	end
end

local function finishCalibrate(gravity, speed, upBoost)
	calibrating = false
	S.GrenAutoCalibrate = false
	if calibConn then pcall(function() calibConn:Disconnect() end) calibConn=nil end
	if gravity then S.GrenGravity = math.clamp(gravity, 40, 400) end
	if speed then S.GrenSpeed = math.clamp(speed, 30, 250) end
	if upBoost then S.GrenUp = math.clamp(upBoost, 0, 100) end
	-- tune related perfect-throw helpers for current values
	S.GrenTrajSteps = math.clamp(math.floor((S.GrenSpeed or 100) / 2), 24, 64)
	S.PerfectThrowLead = math.clamp((S.GrenSpeed or 100) / 700, 0.08, 0.35)
	for _,fn in ipairs(configRefresh) do pcall(fn) end
	setCalibText(string.format("Calibrated: g=%.1f speed=%.1f up=%.1f (applied to both modules)", S.GrenGravity, S.GrenSpeed, S.GrenUp), true)
	print(string.format("[combat hub] grenade calib g=%.2f speed=%.2f up=%.2f", S.GrenGravity, S.GrenSpeed, S.GrenUp))
end

local function estimateFromSamples(samples)
	if #samples < 4 then return nil end
	-- samples: {t, pos}
	local t0 = samples[1].t
	local p0 = samples[1].pos
	-- initial velocity from early samples
	local early = samples[math.min(3, #samples)]
	local dt1 = early.t - t0
	if dt1 <= 1e-3 then return nil end
	local v0 = (early.pos - p0) / dt1
	local speed = Vector3.new(v0.X, 0, v0.Z).Magnitude
	local up = math.max(0, v0.Y)
	-- gravity from vertical motion: y = y0 + v0y*t - 0.5*g*t^2
	local gSum, gN = 0, 0
	for i=3,#samples do
		local t = samples[i].t - t0
		if t > 0.05 then
			local y = samples[i].pos.Y - p0.Y
			-- y = v0y*t - 0.5*g*t^2  =>  g = 2*(v0y*t - y)/t^2
			local g = 2 * (v0.Y * t - y) / (t * t)
			if g > 20 and g < 500 then
				gSum += g
				gN += 1
			end
		end
	end
	if gN < 1 then return nil end
	return gSum / gN, speed, up
end

function startGrenadeCalibrate()
	if calibrating then
		setCalibText("Already calibrating — throw the grenade now", false)
		return
	end
	calibrating = true
	calibSamples = {}
	calibStart = tick()
	setCalibText("Calibrating… equip grenade and THROW once (4s window)", nil)
	local watched = {}
	if calibConn then pcall(function() calibConn:Disconnect() end) end
	calibConn = workspace.DescendantAdded:Connect(function(obj)
		if not calibrating then return end
		if not obj:IsA("BasePart") then return end
		local n = obj.Name:lower()
		local look = n:find("grenade",1,true) or n:find("nade",1,true) or n:find("projectile",1,true)
			or n:find("throw",1,true) or n:find("frag",1,true) or n:find("molotov",1,true)
			or n:find("flash",1,true) or n:find("smoke",1,true) or n:find("ball",1,true)
		-- also accept unanchored parts spawned near camera with velocity
		task.defer(function()
			if not calibrating or not obj.Parent then return end
			local ok,vel = pcall(function() return obj.AssemblyLinearVelocity end)
			if not ok or not vel then return end
			local cam = workspace.CurrentCamera
			if not cam then return end
			local near = (obj.Position - cam.CFrame.Position).Magnitude < 25
			local moving = vel.Magnitude > 20
			if (look or (near and moving and not obj.Anchored)) and not watched[obj] then
				watched[obj] = true
				setCalibText("Tracking projectile…", nil)
				local samples = {}
				local start = tick()
				local conn
				conn = RS.Heartbeat:Connect(function()
					if not obj.Parent or tick()-start > 2.5 then
						conn:Disconnect()
						local g,sp,up = estimateFromSamples(samples)
						if g then
							finishCalibrate(g, sp, up)
						else
							setCalibText("Track failed — try a longer open throw", false)
							calibrating = false
						end
						return
					end
					local ok2,pos = pcall(function() return obj.Position end)
					if ok2 then table.insert(samples, {t=tick(), pos=pos}) end
				end)
			end
		end)
	end)
	-- timeout
	task.delay(5, function()
		if calibrating then
			calibrating = false
			if calibConn then pcall(function() calibConn:Disconnect() end) calibConn=nil end
			setCalibText("Timed out — press again and throw quickly", false)
		end
	end)
end


-- Auto jiggle peek (fixed)
local jiggleOn = false
local jigglePhase = 0
local jiggleOrigin = nil
local function jiggleActive()
	if not S.JigglePeek or S.Panic or not running then return false end
	if bindingCapture or UIS:GetFocusedTextBox() or pointerOverMenu() then return false end
	if S.JiggleADS and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return false end
	if not S.JiggleShoot and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return false end
	local key = S.JiggleKey
	if S.JiggleMode == "Toggle" then return jiggleOn end
	if typeof(key)=="EnumItem" then
		if key.EnumType==Enum.KeyCode then return UIS:IsKeyDown(key) end
		if key.EnumType==Enum.UserInputType then return UIS:IsMouseButtonPressed(key) end
	end
	return UIS:IsKeyDown(Enum.KeyCode.LeftAlt)
end
local function updateJigglePeek(dt)
	local char = LP.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then jiggleOrigin=nil return end
	if not jiggleActive() then
		jiggleOrigin = nil
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then return end
	dt = math.clamp(dt or 1/60, 0, 0.1)
	if not jiggleOrigin then
		jiggleOrigin = hrp.Position
		jigglePhase = 0
	end
	jigglePhase = jigglePhase + (S.JiggleSpeed or 12) * dt
	local side = math.sin(jigglePhase * math.pi * 2) -- full left-right cycle
	local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
	if right.Magnitude < 1e-3 then return end
	right = right.Unit
	local dist = S.JiggleDist or 2.5
	-- target offset from origin along camera right
	local target = jiggleOrigin + right * (side * dist)
	local to = target - hrp.Position
	local flat = Vector3.new(to.X, 0, to.Z)
	local speed = math.max(hum.WalkSpeed, 18) * 1.35
	if flat.Magnitude > 0.05 then
		local dir = flat.Unit
		hum:Move(dir, false)
		local v = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(dir.X * speed, v.Y, dir.Z * speed)
	else
		hum:Move(Vector3.zero, false)
	end
	-- slowly recenter origin so you can walk while jiggling
	jiggleOrigin = jiggleOrigin:Lerp(Vector3.new(hrp.Position.X, jiggleOrigin.Y, hrp.Position.Z), dt * 2)
end


-- Auto inspect / emote on kill
local lastInspect, lastEmote = 0, 0
local lastKills = nil
local healthCache = {}
local recentCombat = {} -- player -> last time we aimed/shot near them
local function pressKey(key, dur)
	if typeof(key)~="EnumItem" or key.EnumType~=Enum.KeyCode then return end
	pcall(function()
		if VIM then
			VIM:SendKeyEvent(true, key, false, game)
			task.delay(dur or 0.08, function()
				pcall(function() VIM:SendKeyEvent(false, key, false, game) end)
			end)
		end
	end)
end
local function doInspect()
	if not S.AutoInspect or S.Panic then return end
	local now = tick()
	if now - lastInspect < 0.2 then return end
	lastInspect = now
	local delay = S.InspectDelay or 0.35
	task.delay(delay, function()
		if S.Panic or not S.AutoInspect then return end
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return end
		pressKey(S.InspectKey or Enum.KeyCode.F, 0.1)
		local char = LP.Character
		local tool = char and char:FindFirstChildOfClass("Tool")
		if tool then
			pcall(function()
				for _,v in ipairs(tool:GetDescendants()) do
					if v:IsA("BindableEvent") and v.Name:lower():find("inspect",1,true) then
						v:Fire(); break
					end
				end
			end)
		end
	end)
end
local function doEmote()
	if not S.AutoEmote or S.Panic then return end
	local now = tick()
	if now - lastEmote < 0.2 then return end
	lastEmote = now
	local delay = S.EmoteDelay or 0.6
	task.delay(delay, function()
		if S.Panic or not S.AutoEmote then return end
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return end
		pressKey(S.EmoteKey or Enum.KeyCode.Period, 0.1)
		pcall(function()
			local char = LP.Character
			local animate = char and char:FindFirstChild("Animate")
			if animate then
				local emote = animate:FindFirstChild("PlayEmote") or animate:FindFirstChildWhichIsA("BindableFunction")
				if emote and emote:IsA("BindableFunction") then
					pcall(function() emote:Invoke("wave") end)
				end
			end
		end)
	end)
end
local function onGotKill()
	if S.InspectOnKill then doInspect() end
	if S.EmoteOnKill then doEmote() end
end
local function markCombat(player)
	if player and player ~= LP then recentCombat[player] = tick() end
end
local function updateInspectEmote()
	if S.Panic or not running then return end
	-- track combat via current aim target
	if CT and CT.Parent then
		local pl = Players:GetPlayerFromCharacter(CT.Parent)
		if pl then markCombat(pl) end
	end
	if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		local cam = workspace.CurrentCamera
		if cam then
			local origin = cam.CFrame.Position
			for _,p in ipairs(Players:GetPlayers()) do
				if p ~= LP and p.Character then
					local root = p.Character:FindFirstChild("HumanoidRootPart")
					if root and (root.Position - origin).Magnitude < 120 then
						markCombat(p)
					end
				end
			end
		end
	end
	-- leaderstats kills
	pcall(function()
		local ls = LP:FindFirstChild("leaderstats")
		local kills = ls and (ls:FindFirstChild("Kills") or ls:FindFirstChild("Kill") or ls:FindFirstChild("Wipes"))
		if kills and (kills:IsA("IntValue") or kills:IsA("NumberValue")) then
			if lastKills ~= nil and kills.Value > lastKills then
				onGotKill()
			end
			lastKills = kills.Value
		end
	end)
	-- health drop to 0 while recently in combat with them
	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				local prev = healthCache[p]
				local hp = hum.Health
				if prev and prev > 0 and hp <= 0 then
					local t = recentCombat[p]
					if t and tick() - t < 8 then
						onGotKill()
					end
				end
				healthCache[p] = hp
			end
		else
			healthCache[p] = nil
		end
	end
end
connect(Players.PlayerRemoving, function(p)
	healthCache[p] = nil
	recentCombat[p] = nil
end)


--------------------------------------------------------------------
-- LOGIC
--------------------------------------------------------------------
local friendshipCache={}
local function alive(p)
    if not p or p==LP then return false end
    local char=p.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return false end
    if S.IgnoreDowned and hum.Health<=5 then return false end
    if S.TeamCheck and not p.Neutral and not LP.Neutral and p.Team and p.Team==LP.Team then return false end
    if S.IgnoreFriends then
        local cached=friendshipCache[p.UserId]
        if cached==nil then
            friendshipCache[p.UserId]="pending"
            task.spawn(function()
                local ok,result=pcall(function() return LP:IsFriendsWith(p.UserId) end)
                if running and p.Parent then friendshipCache[p.UserId]=ok and result or false end
            end)
            return false
        elseif cached=="pending" or cached==true then return false end
    end
    return true
end
connect(Players.PlayerRemoving,function(p) friendshipCache[p.UserId]=nil end)

local function lineOfSight(part)
    if not part or not part.Parent then return false end
    local camera=workspace.CurrentCamera
    if not camera then return false end
    local origin=camera.CFrame.Position
    local direction=part.Position-origin
    local character=part:FindFirstAncestorOfClass("Model") or part.Parent
    if direction.Magnitude<0.001 then return true end
    local exclusions={camera}
    if LP.Character then table.insert(exclusions,LP.Character) end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.IgnoreWater=true
    for _=1,12 do
        params.FilterDescendantsInstances=exclusions
        local hit=workspace:Raycast(origin,direction,params)
        if not hit or hit.Instance:IsDescendantOf(character) then return true end
        local obstacle=hit.Instance
        if obstacle:IsA("BasePart") and obstacle.Transparency>=0.95 then
            table.insert(exclusions,obstacle)
        else return false end
    end
    return false
end
local function wallOk(part)
    local camera=workspace.CurrentCamera
    if not camera or not part or not part.Parent then return false end
    if S.VisibleOnly then
        local projected,onScreen=camera:WorldToViewportPoint(part.Position)
        if not onScreen or projected.Z<=0 then return false end
    end
    if S.WallCheck or S.VisibleOnly or S.AutoWall then return lineOfSight(part) end
    return true
end

local randomAimParts=setmetatable({},{__mode="k"})
local function aimPart(char)
    if not char then return nil end
    local root=char:FindFirstChild("HumanoidRootPart")
    local mine=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if S.ForceHeadClose and root and mine and (root.Position-mine.Position).Magnitude<=S.CloseRange then
        return char:FindFirstChild("Head") or root
    end
    if S.HeadOnly then return char:FindFirstChild("Head") or root end
    if S.LockPart=="Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or root end
    if S.LockPart=="Random" then
        local cached=randomAimParts[char]
        if cached and cached.Parent==char then return cached end
        local candidates={}
        for _,name in ipairs({"Head","UpperTorso","Torso","HumanoidRootPart"}) do
            local part=char:FindFirstChild(name); if part and part:IsA("BasePart") then table.insert(candidates,part) end
        end
        if #candidates>0 then local part=candidates[math.random(1,#candidates)]; randomAimParts[char]=part; return part end
    end
    return char:FindFirstChild("Head") or root
end
local function targetMetrics(part,camera,origin,root,fov)
    if not part or not part.Parent or not part:IsA("BasePart") then return nil end
    if root and (part.Position-root.Position).Magnitude>S.MaxDist then return nil end
    if not wallOk(part) then return nil end
    local point,onScreen=camera:WorldToViewportPoint(part.Position)
    if not onScreen or point.Z<=0 then return nil end
    local cross=(Vector2.new(point.X,point.Y)-origin).Magnitude
    if cross>fov then return nil end
    return cross
end
local function getTarget()
    local camera=workspace.CurrentCamera
    if not camera then CT=nil; return nil end
    Cam=camera
    local origin=aimPosition()
    local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local fov=S.FOV+(S.DynFOV and S.DynFOVAdd or 0)
    local current
    if CT and CT.Parent then
        local player=Players:GetPlayerFromCharacter(CT.Parent)
        if player and alive(player) then
            local part=aimPart(player.Character)
            if targetMetrics(part,camera,origin,root,fov) then current=part end
        end
    end
    if current and (S.StickyAim or os.clock()-lastSwitch<S.SwitchDelay) then CT=current; return current end
    local best,bestScore=nil,math.huge
    for _,player in ipairs(Players:GetPlayers()) do
        if alive(player) then
            local part=aimPart(player.Character)
            local cross=targetMetrics(part,camera,origin,root,fov)
            if cross then
                local score=cross
                if S.Priority=="Distance" then score=(part.Position-(root and root.Position or camera.CFrame.Position)).Magnitude
                elseif S.Priority=="LowestHP" then local hum=player.Character and player.Character:FindFirstChildOfClass("Humanoid"); score=hum and hum.Health or math.huge end
                if score<bestScore then bestScore=score; best=part end
            end
        end
    end
    if best~=CT then lastSwitch=os.clock() end
    CT=best
    return best
end
local function aimOn()
    if S.Panic or not S.Aimbot or bindingCapture or UIS:GetFocusedTextBox() or pointerOverMenu() then return false end
    if S.ADSOnly and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return false end
    if S.AimMode=="Toggle" then return S.AimOn end
    if S.AimKeyMouse then return UIS:IsMouseButtonPressed(S.AimKey) end
    return UIS:IsKeyDown(S.AimKey)
end
local function moveTo(part,str,dt)
    local camera=workspace.CurrentCamera
    if not camera or not part or not part.Parent then return end
    local pos=part.Position+part.AssemblyLinearVelocity*S.Prediction
    if S.Humanize then
        local t=os.clock()
        pos+=Vector3.new(math.noise(t*3,0),math.noise(0,t*3),math.noise(t*3,t*3))*S.Jitter
    end
    local point,onScreen=camera:WorldToViewportPoint(pos)
    if not onScreen or point.Z<=0 then return end
    local origin=aimPosition()
    local distance=(Vector2.new(point.X,point.Y)-origin).Magnitude
    local rate=math.clamp(str,0,1)
    if S.MagnetAim and distance<S.FOV*0.35 then rate=math.max(rate,S.MagnetStr) end
    local alpha=1-(1-rate)^(math.clamp(dt or 1/60,0,0.1)*60)
    if S.AimMethod=="Mouse" and type(mousemoverel)=="function" then
        mousemoverel((point.X-origin.X)*alpha,(point.Y-origin.Y)*alpha)
    else
        if (pos-camera.CFrame.Position).Magnitude>0.001 then
            camera.CFrame=camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position,pos),alpha)
        end
    end
end

local function click()
    if not running or S.Panic or bindingCapture then return end
    local function single()
        if not running or S.Panic then return end
        if type(mouse1click)=="function" then pcall(mouse1click)
        else
            local point=aimPosition()
            if not VIM then return end
            local ok=pcall(function() VIM:SendMouseButtonEvent(point.X,point.Y,0,true,game,0) end)
            if ok then task.defer(function() pcall(function() VIM:SendMouseButtonEvent(point.X,point.Y,0,false,game,0) end) end) end
        end
    end
    single()
    if S.DoubleTap then task.delay(S.DoubleTapDelay or 0.04,single) end
end

pcall(function()
	if type(hookmetamethod)~="function" or type(checkcaller)~="function" then return end
	local old; old=hookmetamethod(game,"__index",function(self,key)
		if running and S.SilentAim and not S.Panic and not bindingCapture and not checkcaller() and typeof(self)=="Instance" and self:IsA("Mouse") and (key=="Hit" or key=="Target") then
			local chance=S.HitChance
			if S.FirstBullet and (not shootStart or tick()-shootStart < 0.05) then chance=100 end
			if math.random(1,100)<=chance then
				local t=CT
				if t and t.Parent then
					if S.SilentFovOnly then
						local cam=workspace.CurrentCamera
						if cam then
							local p,on=cam:WorldToViewportPoint(t.Position)
							local origin=aimPosition()
							local fov=S.FOV+(S.DynFOV and S.DynFOVAdd or 0)
							if not on or (Vector2.new(p.X,p.Y)-origin).Magnitude>fov then return old(self,key) end
						end
					end
					local cf=t.CFrame+(t.AssemblyLinearVelocity*S.Prediction)
					if key=="Hit" then return cf end
					if key=="Target" then return t end
				end
			end
		end
		return old(self,key)
	end)
end)

connect(RS.RenderStepped,function(dt)
	Cam=workspace.CurrentCamera; if not Cam then return end
    if S.Panic then
        WM.Visible=false; RadarF.Visible=false
        if FOVc then FOVc.Visible=false end
        for _,line in pairs(CH) do line.Visible=false end
        hideGrenTraj()
        return
    end
	if S.Watermark then
		WM.Visible=true
		WM.Text=string.format("  COMBAT HUB | %d fps | %d ms",math.floor(1/math.max(dt,0.001)),math.floor(LP:GetNetworkPing()*1000))
	else WM.Visible=false end

	pcall(updateShootStance)
	pcall(function() updateJigglePeek(dt) end)
	pcall(updateInspectEmote)

	local fov=S.FOV+(S.DynFOV and S.DynFOVAdd or 0)
	if FOVc then local mp=aimPosition(); FOVc.Position=Vector2.new(mp.X,mp.Y); FOVc.Radius=fov; FOVc.Visible=S.ShowFOV and (S.Aimbot or S.AimAssist or S.SilentAim) and not S.Panic; FOVc.Color=CT and Color3.fromRGB(255,70,70) or Color3.fromRGB(255,255,255) end
	if CH[1] then local mp=aimPosition(); local s,g=S.CrosshairSize or 6,S.CrosshairGap or 3; local v=S.Crosshair
		CH[1].From=Vector2.new(mp.X-s-g,mp.Y) CH[1].To=Vector2.new(mp.X-g,mp.Y) CH[1].Visible=v
		CH[2].From=Vector2.new(mp.X+g,mp.Y) CH[2].To=Vector2.new(mp.X+s+g,mp.Y) CH[2].Visible=v
		CH[3].From=Vector2.new(mp.X,mp.Y-s-g) CH[3].To=Vector2.new(mp.X,mp.Y-g) CH[3].Visible=v
		CH[4].From=Vector2.new(mp.X,mp.Y+g) CH[4].To=Vector2.new(mp.X,mp.Y+s+g) CH[4].Visible=v
	end

	pcall(updateGrenadeTrajectory)
	pcall(function() updatePerfectThrow(dt) end)

	-- anti recoil (camera moves like mouse)
	local shooting = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	if S.AntiRecoil and not S.Panic and (not S.AROnlyShoot or shooting) and shooting then
		if not savedPitch then savedPitch=Cam.CFrame; shootStart=tick(); patternMul=1 end
		if S.Pattern then patternMul=math.min(S.PatternCap,patternMul+(S.PatternScale or 0.15)*dt*60) end
		local v = math.clamp((S.VStr or 2.4)*patternMul, 0, 20)
		local h = ((math.floor((tick()-(shootStart or tick()))*10)%2==0) and 1 or -1)*(S.HStr or 0.6)*patternMul
		local smooth = math.clamp(S.ARSmooth or 1, 0.2, 1)
		local mode = S.ARMode or "Camera"
		local skipAim = aimOn() or S.AimAssist
		if not skipAim then
			-- pixel deltas similar to mouse movement
			local dx = h * dt * 60 * smooth
			local dy = -v * dt * 60 * smooth
			if (mode=="Mouse" or mode=="Both") and type(mousemoverel)=="function" then
				mousemoverel(dx, dy)
			end
			if mode=="Camera" or mode=="Both" or type(mousemoverel)~="function" then
				-- convert mouse-like deltas into camera pitch/yaw (approx degrees)
				local sens = 0.0022 -- similar feel to mouse look
				local yaw = -dx * sens
				local pitch = -dy * sens
				local cf = Cam.CFrame
				local pos = cf.Position
				-- yaw around world up, pitch around camera right
				local rotated = CFrame.fromAxisAngle(Vector3.yAxis, yaw) * (cf - pos)
				rotated = CFrame.fromAxisAngle(rotated.RightVector, pitch) * rotated
				local look = rotated.LookVector
				if S.LockPitch and savedPitch then
					look = Vector3.new(look.X, savedPitch.LookVector.Y, look.Z)
					if look.Magnitude > 1e-4 then look = look.Unit end
				end
				Cam.CFrame = CFrame.new(pos, pos + look)
			end
		elseif S.LockPitch and savedPitch and not aimOn() then
			local look,pos,base=Cam.CFrame.LookVector,Cam.CFrame.Position,savedPitch.LookVector
			local flat=Vector3.new(look.X,0,look.Z)
			if flat.Magnitude>0.001 then Cam.CFrame=CFrame.new(pos,pos+Vector3.new(flat.Unit.X,base.Y,flat.Unit.Z).Unit) end
		end
	else
		if savedPitch and (not shooting) then
			-- small grace then reset spray state
			if shootStart and tick()-shootStart > (S.ARReset or 0.2) then
				savedPitch=nil; patternMul=1; shootStart=0
			end
		elseif not shooting then
			savedPitch=nil; patternMul=1
		end
	end
    if S.AntiRecoil or S.NoSpread or S.RapidFire or S.InfAmmo then
        local char=LP.Character; local tool=char and char:FindFirstChildOfClass("Tool")
        if tool then for _,value in ipairs(tool:GetDescendants()) do
            if value:IsA("NumberValue") or value:IsA("IntValue") then
                local name=value.Name:lower()
                if S.AntiRecoil and (name:find("recoil",1,true) or name:find("kick",1,true) or name:find("punch",1,true) or name:find("shake",1,true)) then setProperty("AntiRecoil",value,"Value",0) end
                if S.NoSpread and (name:find("spread",1,true) or name:find("bloom",1,true)) then setProperty("NoSpread",value,"Value",0) end
                if S.RapidFire and value:IsA("NumberValue") and (name:find("cooldown",1,true) or name:find("delay",1,true)) then setProperty("RapidFire",value,"Value",0.02) end
                if S.InfAmmo and (name:find("ammo",1,true) or name:find("clip",1,true)) then setProperty("InfAmmo",value,"Value",999) end
            end
        end end
    end


	if S.CustomFOV then setProperty("CustomFOV",Cam,"FieldOfView",S.FOVVal) end
	if S.ThirdPerson then setProperty("ThirdPerson",LP,"CameraMaxZoomDistance",12); setProperty("ThirdPerson",LP,"CameraMinZoomDistance",8) end
	if S.TimeChanger then setProperty("TimeChanger",Lighting,"ClockTime",S.TimeVal) end
    if S.NoFlash and os.clock()-lastFlashScan>0.25 then
        lastFlashScan=os.clock()
        local playerGui=LP:FindFirstChildOfClass("PlayerGui")
        if playerGui then
            for _,g in ipairs(playerGui:GetDescendants()) do
                if g:IsA("Frame") or g:IsA("ImageLabel") then
                    local name=g.Name:lower()
                    if name:find("flash",1,true) or name:find("blind",1,true) then setProperty("NoFlash",g,"Visible",false) end
                end
            end
        end
    end
    if S.NoParticles and not particlesApplied then
        particlesApplied=true
        for _,object in ipairs(workspace:GetDescendants()) do
            if object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Smoke") then setProperty("NoParticles",object,"Enabled",false) end
        end
    end

	if S.Orbit and not S.Panic and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
		local t=getTarget(); if t then orbitAng+=S.OrbitSpd*dt; local o=Vector3.new(math.cos(orbitAng)*S.OrbitRng,0,math.sin(orbitAng)*S.OrbitRng); LP.Character.HumanoidRootPart.CFrame=CFrame.new(t.Position+o,t.Position) end
	end
	if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
		local hrp=LP.Character.HumanoidRootPart
		if S.Spinbot then hrp.CFrame=hrp.CFrame*CFrame.Angles(0,math.rad(S.SpinSpd)*dt*60,0)
		elseif S.AntiAim then hrp.CFrame=hrp.CFrame*CFrame.Angles(0,math.rad(math.random(-25,25)),0) end
	end

    -- Radar markers are reused until a player becomes invalid.
    RadarF.Visible=S.Radar; RadarF.Size=UDim2.fromOffset(S.RadarSize or 140,S.RadarSize or 140); RadarF.Position=UDim2.new(1,-(S.RadarPosX or 160),0,S.RadarPosY or 20)
    local radarRoot=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local seen={}
    if S.Radar and radarRoot then
        for _,player in ipairs(Players:GetPlayers()) do
            local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if root and alive(player) then
                seen[player]=true
                local dot=radarDots[player]
                if not dot then dot=Instance.new("Frame",RadarF); dot.Size=UDim2.fromOffset(4,4); dot.BorderSizePixel=0; corner(dot,2); radarDots[player]=dot end
                local rel=radarRoot.CFrame:PointToObjectSpace(root.Position)
                local sc=S.RadarScale or 2; dot.Position=UDim2.new(0.5,math.clamp(rel.X/sc,-65,65)-2,0.5,math.clamp(rel.Z/sc,-65,65)-2)
                dot.BackgroundColor3=S.ESPColor
            end
        end
    end
    for player,dot in pairs(radarDots) do if not seen[player] then dot:Destroy(); radarDots[player]=nil end end

end)

local aimRenderName="CombatHubAim_"..HS:GenerateGUID(false)
RS:BindToRenderStep(aimRenderName,Enum.RenderPriority.Camera.Value+1,function(dt)
    if not running or S.Panic or not Gui.Parent or freecamConn then CT=nil; return end
    local active=aimOn()
    local assist=S.AimAssist and not bindingCapture and not UIS:GetFocusedTextBox() and not pointerOverMenu()
    if not active and not assist then if S.SilentAim then getTarget() else CT=nil end; return end
    local target=getTarget()
    if not target then return end
    local strength=active and S.Smooth or S.AssistStr
    if active and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then strength=S.HipfireSmooth end
    if active then
        local camera=workspace.CurrentCamera
        if not camera then return end
        local point=camera:WorldToViewportPoint(target.Position)
        local distance=(Vector2.new(point.X,point.Y)-aimPosition()).Magnitude
        local close=math.clamp(1-distance/math.max(S.FOV,1),0,1)
        strength=strength+(1-strength)*S.SnapBlend*close
    end
    moveTo(target,strength,dt)
end)
connect(Gui.Destroying,function() RS:UnbindFromRenderStep(aimRenderName); S.Panic=true; CT=nil; HK=false; S.AimOn=false end)
connect(UIS.WindowFocusReleased,function() HK=false; S.AimOn=false; if cancelCapture then cancelCapture() end end)
connect(LP.CharacterAdded,function() CT=nil; HK=false; S.AimOn=false; savedPitch=nil end)

local lastShot=0
connect(RS.Heartbeat,function()
	if S.Panic then return end
    local shotDelay = (S.AutoShoot and S.AutoShootDelay) or S.TriggerDelay or 0.08
    if (S.Triggerbot or S.AutoShoot) and tick()-lastShot>shotDelay and not bindingCapture and not UIS:GetFocusedTextBox() then
        local menuHover=pointerOverMenu()
        if not menuHover then
            local fire=false
            local camera=workspace.CurrentCamera
            if S.Triggerbot and camera then
                local aimPoint=aimPosition(); local ray=camera:ViewportPointToRay(aimPoint.X,aimPoint.Y)
                local params=RaycastParams.new()
                params.FilterType=Enum.RaycastFilterType.Exclude
                local exclude={camera}
                if LP.Character then table.insert(exclude,LP.Character) end
                params.FilterDescendantsInstances=exclude; params.IgnoreWater=true
                local range = math.max(S.TriggerRange or 22, 5)
                local hit=workspace:Raycast(ray.Origin,ray.Direction*math.min(S.MaxDist, range*20),params)
                if hit then
                    local model=hit.Instance
                    local player
                    while model and model~=workspace do
                        if model:IsA("Model") then player=Players:GetPlayerFromCharacter(model); if player then break end end
                        model=model.Parent
                    end
                    if player and alive(player) then
                        local sp,on = camera:WorldToViewportPoint(hit.Position)
                        local dist2d = on and (Vector2.new(sp.X,sp.Y)-aimPoint).Magnitude or math.huge
                        if dist2d <= (S.TriggerRange or 22) and wallOk(hit.Instance) then fire=true end
                    end
                end
            end
            if not fire and S.AutoShoot then
                local target=getTarget()
                fire=target~=nil and lineOfSight(target)
            end
            if fire then
                lastShot=tick()
                click()
                if S.HitMarker then showHitMarker() end
                if S.BulletTrace then local t=CT; if t then showBulletTrace(t.Position) end end
            end
        end
    end
	if S.KillAura and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
		local my=LP.Character.HumanoidRootPart.Position
		for _,p in ipairs(Players:GetPlayers()) do
			if alive(p) and p.Character:FindFirstChild("HumanoidRootPart") and (p.Character.HumanoidRootPart.Position-my).Magnitude<=S.AuraRange then
				local tool=LP.Character:FindFirstChildOfClass("Tool"); if tool then pcall(function() tool:Activate() end) end; break
			end
		end
	end
	if S.Hitbox then
		for _,p in ipairs(Players:GetPlayers()) do if alive(p) then
			for _,n in ipairs(S.HeadOnly and {"Head"} or {"Head","HumanoidRootPart","UpperTorso","Torso"}) do
				local part=p.Character and p.Character:FindFirstChild(n)
				if part and part:IsA("BasePart") then setProperty("Hitbox",part,"Size",Vector3.new(S.HitboxSize,S.HitboxSize,S.HitboxSize)); setProperty("Hitbox",part,"Transparency",0.65); setProperty("Hitbox",part,"CanCollide",false) end
			end
		end end
	else restoreModule("Hitbox") end

	local char=LP.Character; if not char then return end
	local hum=char:FindFirstChildOfClass("Humanoid"); if not hum then return end
	if S.Speed then setProperty("Speed",hum,"WalkSpeed",S.SpeedVal) end
	if S.JumpPow then setProperty("JumpPow",hum,"UseJumpPower",true); setProperty("JumpPow",hum,"JumpPower",S.JumpVal) end
	if S.Bhop and hum.FloorMaterial~=Enum.Material.Air and UIS:IsKeyDown(Enum.KeyCode.Space) then hum.Jump=true end
	if S.EdgeJump and hum.FloorMaterial~=Enum.Material.Air then
		local root=char:FindFirstChild("HumanoidRootPart")
		if root then local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={char}; local r=workspace:Raycast(root.Position,Vector3.new(0,-(hum.HipHeight+root.Size.Y/2+0.6),0),params) if not r then hum.Jump=true end end
	end
	if S.CrouchSpam then setProperty("CrouchSpam",hum,"HipHeight",(os.clock()%.2<0.1) and 0.5 or 2) end
	if S.God then hum.Health=hum.MaxHealth end
	if S.AutoHeal and hum.Health<hum.MaxHealth*0.5 then hum.Health=math.min(hum.MaxHealth,hum.Health+1) end
	if S.NoFall then
        local states=humanoidStates[hum]
        if not states then states={}; humanoidStates[hum]=states end
        for _,state in ipairs({Enum.HumanoidStateType.FallingDown,Enum.HumanoidStateType.Ragdoll}) do
            if states[state]==nil then states[state]=hum:GetStateEnabled(state) end
            hum:SetStateEnabled(state,false)
        end
    end
	if S.AntiStun then setProperty("AntiStun",hum,"WalkSpeed",math.max(hum.WalkSpeed,16)) end
	if S.AirStrafe and hum.FloorMaterial==Enum.Material.Air and char:FindFirstChild("HumanoidRootPart") then
		local hrp=char.HumanoidRootPart; local dir=Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.A) then dir-=Cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then dir+=Cam.CFrame.RightVector end
		if dir.Magnitude>0 then hrp.AssemblyLinearVelocity=Vector3.new(dir.Unit.X*hrp.AssemblyLinearVelocity.Magnitude,hrp.AssemblyLinearVelocity.Y,dir.Unit.Z*hrp.AssemblyLinearVelocity.Magnitude) end
	end

    if S.ChatSpam and not chatBusy and tick()-lastChat>=S.ChatDelay then
        lastChat=tick(); sendChatMessage(S.ChatMsg)
    end
end)

connect(RS.RenderStepped,function()
	if not S.Fly or S.Panic then return end
	local char=LP.Character; if not char then return end; local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
	if not BV or BV.Parent~=hrp or not BG or BG.Parent~=hrp then if BV then BV:Destroy() end; if BG then BG:Destroy() end; BV=Instance.new("BodyVelocity"); BV.MaxForce=Vector3.new(9e9,9e9,9e9); BV.Parent=hrp; BG=Instance.new("BodyGyro"); BG.MaxTorque=Vector3.new(9e9,9e9,9e9); BG.Parent=hrp end
	Cam=workspace.CurrentCamera; if not Cam then return end
	BG.CFrame=Cam.CFrame; local dir=Vector3.zero
	if UIS:IsKeyDown(Enum.KeyCode.W) then dir+=Cam.CFrame.LookVector end
	if UIS:IsKeyDown(Enum.KeyCode.S) then dir-=Cam.CFrame.LookVector end
	if UIS:IsKeyDown(Enum.KeyCode.A) then dir-=Cam.CFrame.RightVector end
	if UIS:IsKeyDown(Enum.KeyCode.D) then dir+=Cam.CFrame.RightVector end
	if UIS:IsKeyDown(Enum.KeyCode.Space) then dir+=Vector3.yAxis end
	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir-=Vector3.yAxis end
	BV.Velocity=dir.Magnitude>0 and dir.Unit*S.FlySpeed or Vector3.zero
end)

connect(UIS.JumpRequest,function()
	if S.Panic then return end
	if S.InfJump and LP.Character then local h=LP.Character:FindFirstChildOfClass("Humanoid"); if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end
	if S.LongJump and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then local hrp=LP.Character.HumanoidRootPart; hrp.AssemblyLinearVelocity=hrp.AssemblyLinearVelocity+Cam.CFrame.LookVector*80+Vector3.new(0,40,0) end
end)

connect(RS.Stepped,function()
	if S.Noclip and not S.Panic and LP.Character then for _,p in ipairs(LP.Character:GetDescendants()) do if p:IsA("BasePart") then setProperty("Noclip",p,"CanCollide",false) end end end
end)

local ESPGui=Instance.new("ScreenGui")
ESPGui.Name="CombatHubESP"; ESPGui.IgnoreGuiInset=true; ESPGui.ResetOnSpawn=false; ESPGui.DisplayOrder=998
ESPGui.Parent=Gui.Parent
local function clearESP(p)
    local pack=ESP[p]
    if not pack then return end
    for key,object in pairs(pack) do if key~="character" and typeof(object)=="Instance" then pcall(function() object:Destroy() end) end end
    ESP[p]=nil
end
local function makeESP(p)
    clearESP(p)
    local pack={}
    local box=Instance.new("Frame",ESPGui); box.BackgroundTransparency=1; box.BorderSizePixel=0; box.Visible=false
    local outline=Instance.new("UIStroke",box); outline.Thickness=S.BoxThickness or 1.5
    pack.box=box; pack.outline=outline
    local text=Instance.new("TextLabel",ESPGui); text.BackgroundTransparency=1; text.TextStrokeTransparency=0.25; text.Font=Enum.Font.GothamBold; text.TextSize=S.NameSize or 12; text.TextWrapped=false; text.Visible=false
    pack.text=text
    local line=Instance.new("Frame",ESPGui); line.BorderSizePixel=0; line.AnchorPoint=Vector2.new(0.5,0.5); line.Visible=false
    pack.line=line
    pack.character=p.Character
    ESP[p]=pack
    return pack
end
local function projectedBounds(char,camera)
    local cf,size=char:GetBoundingBox()
    local minX,minY,maxX,maxY=math.huge,math.huge,-math.huge,-math.huge
    for x=-1,1,2 do for y=-1,1,2 do for z=-1,1,2 do
        local point=camera:WorldToViewportPoint(cf:PointToWorldSpace(Vector3.new(x*size.X/2,y*size.Y/2,z*size.Z/2)))
        if point.Z<=0.1 then return nil end
        minX=math.min(minX,point.X); minY=math.min(minY,point.Y)
        maxX=math.max(maxX,point.X); maxY=math.max(maxY,point.Y)
    end end end
    local viewport=camera.ViewportSize
    if maxX<0 or maxY<0 or minX>viewport.X or minY>viewport.Y then return nil end
    return minX,minY,maxX,maxY
end
local espConnection=connect(RS.RenderStepped,function()
    local camera=workspace.CurrentCamera
    local enabled=not S.Panic and (S.Chams or S.NameESP or S.DistESP or S.HPESP or S.WeaponESP or S.BoxESP or S.Tracers)
    if not camera or not enabled then for p in pairs(ESP) do clearESP(p) end; return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP then
            local char=p.Character
            local root=char and char:FindFirstChild("HumanoidRootPart")
            local localRoot=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local checkPart=char and (char:FindFirstChild("Head") or root)
            local withinRange=root and (not localRoot or (root.Position-localRoot.Position).Magnitude<=(S.ESPMaxDist or S.MaxDist))
            if not alive(p) or not root or not withinRange then clearESP(p)
            else
                local pack=ESP[p]
                if not pack or pack.character~=char then pack=makeESP(p) end
                local color=S.ESPColor
                if S.Chams then
                    if not pack.hl then
                        local h=Instance.new("Highlight"); h.Adornee=char; h.FillTransparency=S.ChamsFill or 0.5; h.OutlineTransparency=S.ChamsOutline or 0; h.Parent=char; pack.hl=h
                    end
                    pack.hl.FillColor=color; pack.hl.OutlineColor=color; pack.hl.FillTransparency=S.ChamsFill or 0.5; pack.hl.OutlineTransparency=S.ChamsOutline or 0
                    pack.hl.DepthMode=(S.ChamsDepth=="Occluded") and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
                elseif pack.hl then pack.hl:Destroy(); pack.hl=nil end
                local x1,y1,x2,y2=projectedBounds(char,camera)
                pack.box.Visible=S.BoxESP and x1~=nil
                pack.text.Visible=(S.NameESP or S.DistESP or S.HPESP or S.WeaponESP) and x1~=nil
                pack.line.Visible=S.Tracers and x1~=nil
                if x1 then
                    pack.box.Position=UDim2.fromOffset(x1,y1); pack.box.Size=UDim2.fromOffset(x2-x1,y2-y1); pack.outline.Color=color; pack.outline.Thickness=S.BoxThickness or 1.5
                    if S.HPBar then
                        if not pack.hpBg then
                            local bg=Instance.new("Frame",ESPGui); bg.BorderSizePixel=0; bg.BackgroundColor3=Color3.fromRGB(30,30,30); bg.Visible=false
                            local fill=Instance.new("Frame",bg); fill.BorderSizePixel=0; fill.BackgroundColor3=Color3.fromRGB(80,220,120); fill.Size=UDim2.new(1,0,1,0)
                            pack.hpBg=bg; pack.hpFill=fill
                        end
                        local hum=char:FindFirstChildOfClass("Humanoid")
                        local pct=hum and math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1) or 1
                        local bh=S.HPBarH or 3
                        pack.hpBg.Visible=true
                        pack.hpBg.Position=UDim2.fromOffset(x1,y2+2)
                        pack.hpBg.Size=UDim2.fromOffset(math.max(x2-x1,4),bh)
                        pack.hpFill.Size=UDim2.new(pct,0,1,0)
                        pack.hpFill.BackgroundColor3=Color3.fromRGB(255*(1-pct),220*pct,80)
                    elseif pack.hpBg then pack.hpBg.Visible=false end
                    local bits={}
                    if S.NameESP then table.insert(bits,p.DisplayName.." (@"..p.Name..")") end
                    if S.DistESP and localRoot then table.insert(bits,tostring(math.floor((root.Position-localRoot.Position).Magnitude)).." studs") end
                    if S.HPESP then local h=char:FindFirstChildOfClass("Humanoid"); if h then table.insert(bits,tostring(math.floor(h.Health)).." HP") end end
                    if S.WeaponESP then local tool=char:FindFirstChildOfClass("Tool"); if tool then table.insert(bits,tool.Name) end end
                    pack.text.Text=table.concat(bits," | "); pack.text.TextSize=S.NameSize or 12; pack.text.TextStrokeTransparency=(S.ESPTextOutline~=false) and 0.25 or 1
                    local drawColor=color
                    if S.RainbowESP then
                        local h=(os.clock()*(S.RainbowSpeed or 0.4))%1
                        drawColor=Color3.fromHSV(h,0.9,1)
                    elseif S.ESPTeamColor and p.Team and p.Team.TeamColor then
                        drawColor=p.Team.TeamColor.Color
                    end
                    pack.text.TextColor3=drawColor; color=drawColor
                    local width=math.max(x2-x1,360)
                    pack.text.Size=UDim2.fromOffset(width,20); pack.text.Position=UDim2.fromOffset((x1+x2-width)/2,y1-22)
                    local originMode=S.TracerOrigin or "Bottom"
                    local a
                    if originMode=="Center" then a=Vector2.new(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
                    elseif originMode=="Top" then a=Vector2.new(camera.ViewportSize.X/2,4)
                    else a=Vector2.new(camera.ViewportSize.X/2,camera.ViewportSize.Y-4) end
                    local b=Vector2.new((x1+x2)/2,y2); local delta=b-a; local center=(a+b)/2
                    pack.line.Position=UDim2.fromOffset(center.X,center.Y); pack.line.Size=UDim2.fromOffset(delta.Magnitude,S.TracerThickness or 1.5)
                    pack.line.Rotation=math.deg(math.atan2(delta.Y,delta.X)); pack.line.BackgroundColor3=color
                end
            end
        end
    end
end)
local espRemoving=connect(Players.PlayerRemoving,clearESP)
connect(Gui.Destroying,function()
    espConnection:Disconnect(); espRemoving:Disconnect()
    for p in pairs(ESP) do clearESP(p) end
    ESPGui:Destroy()
end)

pcall(function() local vu=game:GetService("VirtualUser"); connect(LP.Idled,function() if S.AntiAFK then vu:CaptureController(); vu:ClickButton2(Vector2.new()) end end) end)

local function isAimKey(i) if S.AimKeyMouse then return i.UserInputType==S.AimKey end return i.KeyCode==S.AimKey end
connect(UIS.InputBegan,function(i,g)
    if isAimKey(i) and S.Aimbot and not bindingCapture and not UIS:GetFocusedTextBox() and not pointerOverMenu() then
        if S.AimMode=="Toggle" then S.AimOn=not S.AimOn else HK=true end
    end
	if g or bindingCapture or UIS:GetFocusedTextBox() then return end
	if i.KeyCode==Enum.KeyCode.RightShift then Main.Visible=not Main.Visible end
	if S.JigglePeek and S.JiggleMode=="Toggle" and typeof(S.JiggleKey)=="EnumItem" and S.JiggleKey.EnumType==Enum.KeyCode and i.KeyCode==S.JiggleKey then
		jiggleOn = not jiggleOn
	end
	if i.KeyCode==S.PanicKey then if S.Panic then S.Panic=false else panicAll() end; return end
    if S.Panic then return end
    Cam=workspace.CurrentCamera; if not Cam then return end

	if S.Dash and not pointerOverMenu() and i.KeyCode==Enum.KeyCode.Q and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
		local hrp=LP.Character.HumanoidRootPart; hrp.AssemblyLinearVelocity=Cam.CFrame.LookVector*S.DashPower+Vector3.new(0,20,0)
	end
	if S.ClickTP and not pointerOverMenu() and i.UserInputType==Enum.UserInputType.MouseButton1 and Mouse.Hit and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
		LP.Character.HumanoidRootPart.CFrame=CFrame.new(Mouse.Hit.Position+Vector3.new(0,3,0))
	end
	if S.Freecam and i.KeyCode==Enum.KeyCode.P and UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
		if freecamConn then stopFreecam()
		else
			Cam=workspace.CurrentCamera; if not Cam then return end; freecamPos=Cam.CFrame; setProperty("Freecam",Cam,"CameraType",Enum.CameraType.Scriptable); setProperty("Freecam",Cam,"CFrame",freecamPos)
			freecamConn=connect(RS.RenderStepped,function(dt)
                if S.Panic or not S.Freecam or UIS:GetFocusedTextBox() then return end
				local dir=Vector3.zero
				if UIS:IsKeyDown(Enum.KeyCode.W) then dir+=Cam.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then dir-=Cam.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then dir-=Cam.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then dir+=Cam.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.E) then dir+=Vector3.yAxis end
				if UIS:IsKeyDown(Enum.KeyCode.Q) then dir-=Vector3.yAxis end
				freecamPos=freecamPos+dir*60*dt; Cam.CFrame=CFrame.new(freecamPos.Position,freecamPos.Position+freecamPos.LookVector)
			end)
		end
	end
end)
connect(UIS.InputEnded,function(i) if isAimKey(i) then HK=false end end)


connect(workspace.DescendantAdded,function(object)
    if not S.Panic and S.NoParticles and (object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Smoke")) then setProperty("NoParticles",object,"Enabled",false) end
end)
panicAll=function()
    for key,value in pairs(S) do
        if type(value)=="boolean" and key~="AimKeyMouse" and key~="Panic" then S[key]=false end
    end
    S.Panic=true; S.AimOn=false; HK=false; CT=nil; bindingCapture=false; jiggleOn=false
    if cancelCapture then cancelCapture() end
    stopFreecam()
    pcall(function() if VIM then VIM:SendKeyEvent(false, S.CrouchKey or Enum.KeyCode.LeftShift, false, game) end end)
    if BV then BV:Destroy(); BV=nil end
    if BG then BG:Destroy(); BG=nil end
    restoreAll(); particlesApplied=false
    for player in pairs(ESP) do clearESP(player) end
    for player,dot in pairs(radarDots) do dot:Destroy(); radarDots[player]=nil end
    WM.Visible=false; RadarF.Visible=false
    if FOVc then FOVc.Visible=false end
    for _,line in pairs(CH) do line.Visible=false end
    for _,refresh in ipairs(configRefresh) do pcall(refresh) end
end
dispose=function(destroyGui)
    if not running then return end
    panicAll()
    running=false
    pcall(function() RS:UnbindFromRenderStep(aimRenderName) end)
    for _,connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
    table.clear(connections)
    if FOVc then pcall(function() FOVc:Remove() end); FOVc=nil end
    for key,line in pairs(CH) do pcall(function() line:Remove() end); CH[key]=nil end
    for _,line in ipairs(grenLines) do pcall(function() line:Remove() end) end
    table.clear(grenLines)
    for _,c in ipairs(grenDots) do pcall(function() c:Remove() end) end
    table.clear(grenDots)
    pcall(function() if grenImpact then grenImpact:Remove() end end)
    pcall(function() if grenImpactX1 then grenImpactX1:Remove() end end)
    pcall(function() if grenImpactX2 then grenImpactX2:Remove() end end)
    grenImpact,grenImpactX1,grenImpactX2=nil,nil,nil
    pcall(function() ESPGui:Destroy() end)
    if destroyGui then pcall(function() Gui:Destroy() end) end
end
Gui.Destroying:Connect(function() dispose(false) end)

