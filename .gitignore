-- CONFIGS
 do
    local c=card(pages.config,"Profiles","Save files or copy/paste JSON")
    local function box(text,height)
        local b=Instance.new("TextBox",c); b.Size=UDim2.new(1,0,0,height); b.BackgroundColor3=T.p2; b.TextColor3=T.txt; b.Font=Enum.Font.Code; b.TextSize=12; b.ClearTextOnFocus=false; b.Text=text; b.LayoutOrder=nord(c); corner(b,6); return b
    end
    local profile=box("default",28)
    local json=box("",100); json.MultiLine=true; json.TextWrapped=true; json.TextXAlignment=Enum.TextXAlignment.Left; json.TextYAlignment=Enum.TextYAlignment.Top; json.PlaceholderText="Export JSON here or paste a config to import"
    local status=Instance.new("TextLabel",c); status.Size=UDim2.new(1,0,0,36); status.BackgroundTransparency=1; status.TextColor3=T.dim; status.Font=Enum.Font.Gotham; status.TextSize=11; status.TextWrapped=true; status.Text="Ready"; status.LayoutOrder=nord(c)
    local function run(fn)
        local ok,result=pcall(fn); status.Text=ok and (result or "Done") or ("Error: "..tostring(result)); status.TextColor3=ok and T.ok or T.bad
    end
    local function path()
        local name=profile.Text:match("^%s*(.-)%s*$")
        assert(#name>0 and #name<=48 and name:match("^[%w_-]+$"),"Profile names: letters, numbers, _ and - only")
        return "CombatHubConfigs/"..name..".json"
    end
    local function import(text)
        assert(#text<=262144,"Config exceeds 256 KB")
        local data=HS:JSONDecode(text)
        assert(type(data)=="table" and data.version==1 and type(data.settings)=="table","Invalid config or unsupported version")
        applyConfig(data.settings); HK=false; CT=nil
    end
    btn(c,"Save Profile",function() run(function()
        assert(type(writefile)=="function" and type(isfolder)=="function" and type(makefolder)=="function","File storage unavailable; use Export JSON")
        local target=path(); if not isfolder("CombatHubConfigs") then makefolder("CombatHubConfigs") end
        writefile(target,encodeConfig()); return "Profile saved"
    end) end)
    btn(c,"Load Profile",function() run(function()
        assert(type(readfile)=="function","File storage unavailable; use Import JSON")
        import(readfile(path())); return "Profile loaded"
    end) end)
    btn(c,"Export JSON",function() run(function() json.Text=encodeConfig(); return "JSON exported into the text box" end) end)
    btn(c,"Import JSON",function() run(function() import(json.Text); return "JSON imported" end) end)
    btn(c,"Reset Defaults",function() run(function() applyConfig({}); HK=false; CT=nil; return "Defaults restored" end) end)

