tipStroke.Color = Color3.fromRGB(70, 120, 200)
local tipPad = Instance.new("UIPadding", Tip)
tipPad.PaddingTop = UDim.new(0, 8)
tipPad.PaddingBottom = UDim.new(0, 8)
tipPad.PaddingLeft = UDim.new(0, 10)
tipPad.PaddingRight = UDim.new(0, 10)
local tipTitle = Instance.new("TextLabel", Tip)
tipTitle.Size = UDim2.new(1, 0, 0, 16)
tipTitle.BackgroundTransparency = 1
tipTitle.TextColor3 = Color3.fromRGB(160, 200, 255)
tipTitle.Font = Enum.Font.GothamBold
tipTitle.TextSize = 12
tipTitle.TextXAlignment = Enum.TextXAlignment.Left
tipTitle.ZIndex = 201
local tipBody = Instance.new("TextLabel", Tip)
tipBody.Size = UDim2.new(1, 0, 0, 0)
tipBody.Position = UDim2.new(0, 0, 0, 18)
tipBody.AutomaticSize = Enum.AutomaticSize.Y
tipBody.BackgroundTransparency = 1
tipBody.TextColor3 = Color3.fromRGB(210, 210, 220)
tipBody.Font = Enum.Font.Gotham
tipBody.TextSize = 11
tipBody.TextXAlignment = Enum.TextXAlignment.Left
tipBody.TextWrapped = true
tipBody.ZIndex = 201
local tipConn
local function showTip(name)
	local d = TIPS[name]
	if not d then Tip.Visible = false return end
	tipTitle.Text = name
	tipBody.Text = d
	Tip.Visible = true
	if tipConn then tipConn:Disconnect() end
	tipConn = RS.RenderStepped:Connect(function()
		if not Tip.Visible then return end
		local mp = UIS:GetMouseLocation()
		local cam = workspace.CurrentCamera
		local vs = cam and cam.ViewportSize or Vector2.new(1920, 1080)
		local x, y = mp.X + 16, mp.Y + 16
		if x + 290 > vs.X then x = mp.X - 296 end
		if y + 110 > vs.Y then y = mp.Y - 100 end
		Tip.Position = UDim2.fromOffset(x, y)
	end)
end
local function hideTip()
	Tip.Visible = false
	if tipConn then tipConn:Disconnect(); tipConn = nil end
end
local function bindTip(row, name)
	if not row or not name then return end
	row.MouseEnter:Connect(function() showTip(name) end)
	row.MouseLeave:Connect(hideTip)
end


local Main=Instance.new("Frame",Gui); Main.Size=UDim2.new(0,760,0,540); Main.Position=UDim2.new(.5,-380,.5,-270); Main.BackgroundColor3=T.bg; Main.BorderSizePixel=0; Main.Active=true; Main.Draggable=true; corner(Main,12); stroke(Main)

local function pointerOverMenu()
    if not Main.Visible then return false end
    local point=UIS:GetMouseLocation()-game:GetService("GuiService"):GetGuiInset()
    local origin,size=Main.AbsolutePosition,Main.AbsoluteSize
    return point.X>=origin.X and point.Y>=origin.Y and point.X<=origin.X+size.X and point.Y<=origin.Y+size.Y
end

