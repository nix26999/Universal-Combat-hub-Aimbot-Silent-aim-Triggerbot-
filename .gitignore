    LockPitch="AntiRecoil",VStr="AntiRecoil",HStr="AntiRecoil",Pattern="AntiRecoil",
    PatternScale="Pattern",PatternCap="Pattern",RCSAfter="AntiRecoil",
    SpeedVal="Speed",FlySpeed="Fly",JumpVal="JumpPow",DashPower="Dash",
    OrbitSpd="Orbit",OrbitRng="Orbit",SpinSpd="Spinbot",TimeVal="TimeChanger",
    FOVVal="CustomFOV",ChatDelay="ChatSpam",
    ChamsFill="Chams",ChamsOutline="Chams",
    CrosshairSize="Crosshair",CrosshairGap="Crosshair",
    RadarScale="Radar",
    ESPMaxDist="NameESP",
    HitMarkerSize="HitMarker",HitMarkerTime="HitMarker",
    BulletTraceTime="BulletTrace",
    AutoReloadKey="AutoReload",
    ARMode="AntiRecoil",ARSmooth="AntiRecoil",AROnlyShoot="AntiRecoil",ARReset="AntiRecoil",
    BoxThickness="BoxESP",TracerThickness="Tracers",TracerOrigin="Tracers",
    NameSize="NameESP",ESPTextOutline="NameESP",HPBar="HPESP",HPBarH="HPESP",
    ChamsDepth="Chams",ESPTeamColor="Chams",RainbowESP="Chams",RainbowSpeed="Chams",
    RadarSize="Radar",RadarPosX="Radar",RadarPosY="Radar",
    GrenTrajAlways="GrenadeTraj",GrenTrajSteps="GrenadeTraj",GrenTrajTime="GrenadeTraj",
    GrenGravity="GrenadeTraj",GrenSpeed="GrenadeTraj",GrenUp="GrenadeTraj",
    GrenThickness="GrenadeTraj",GrenBounce="GrenadeTraj",GrenMaxBounces="GrenadeTraj",
    PerfectThrowAuto="PerfectThrow",PerfectThrowLead="PerfectThrow",PerfectThrowSmooth="PerfectThrow",
    PerfectThrowHeight="PerfectThrow",PerfectThrowKey="PerfectThrow",
    CrouchKey="AutoCrouchShoot",StopMoveStrict="StopMoveShoot",
    JiggleKey="JigglePeek",JiggleMode="JigglePeek",JiggleSpeed="JigglePeek",
    JiggleDist="JigglePeek",JiggleADS="JigglePeek",JiggleShoot="JigglePeek",
    InspectKey="AutoInspect",InspectDelay="AutoInspect",InspectOnKill="AutoInspect",
    EmoteDelay="AutoEmote",EmoteKey="AutoEmote",EmoteOnKill="AutoEmote",
}
local function settingsParent(parent,key)
    return modulePanels[settingsOwner[key]] or parent
end

local function tog(parent,name,key,cb)
    if key=="God" or key=="AutoHeal" then name=name.." (local only)" end
    if cb then configCallbacks[key]=cb end
    parent=settingsParent(parent,key)
    local wrapper=Instance.new("Frame",parent)
    wrapper.Name="Module_"..key; wrapper.Size=UDim2.new(1,0,0,0); wrapper.AutomaticSize=Enum.AutomaticSize.Y
    wrapper.BackgroundTransparency=1; wrapper.LayoutOrder=nord(parent)
    local layout=Instance.new("UIListLayout",wrapper); layout.SortOrder=Enum.SortOrder.LayoutOrder; layout.Padding=UDim.new(0,4)
    local body=Instance.new("Frame",wrapper); body.Name="Settings"; body.Size=UDim2.new(1,0,0,0); body.AutomaticSize=Enum.AutomaticSize.Y; body.BackgroundTransparency=1; body.Visible=false; body.LayoutOrder=1
    local bodyLayout=Instance.new("UIListLayout",body); bodyLayout.SortOrder=Enum.SortOrder.LayoutOrder; bodyLayout.Padding=UDim.new(0,6)
    local padding=Instance.new("UIPadding",body); padding.PaddingLeft=UDim.new(0,12); padding.PaddingBottom=UDim.new(0,6)
    modulePanels[key]=body
    local r=Instance.new("Frame",wrapper); r.Size=UDim2.new(1,0,0,28); r.BackgroundTransparency=1; r.LayoutOrder=0
	local lab=Instance.new("TextLabel",r); lab.Size=UDim2.new(1,-82,1,0); lab.Position=UDim2.fromOffset(28,0); lab.BackgroundTransparency=1; lab.Text=name..(unsupported[key] and " (not implemented)" or ""); lab.TextColor3=unsupported[key] and T.mut or T.txt; lab.Font=Enum.Font.Gotham; lab.TextSize=12; lab.TextXAlignment=Enum.TextXAlignment.Left
	local track=Instance.new("Frame",r); track.Size=UDim2.new(0,36,0,18); track.Position=UDim2.new(1,-36,0.5,-9); track.BackgroundColor3=S[key] and T.acc or Color3.fromRGB(45,45,55); track.BorderSizePixel=0; corner(track,9)
	local knob=Instance.new("Frame",track); knob.Size=UDim2.new(0,14,0,14); knob.Position=S[key] and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7); knob.BackgroundColor3=Color3.fromRGB(255,255,255); knob.BorderSizePixel=0; corner(knob,7)
	local b=Instance.new("TextButton",r); b.Size=UDim2.new(1,-28,1,0); b.Position=UDim2.fromOffset(28,0); b.BackgroundTransparency=1; b.Text=""
    local arrow=Instance.new("TextButton",r); arrow.Name="ExpandSettings"; arrow.Size=UDim2.fromOffset(24,24); arrow.Position=UDim2.new(0,0,0.5,-12); arrow.BackgroundTransparency=1; arrow.Text=">"; arrow.TextColor3=T.acc; arrow.Font=Enum.Font.GothamBold; arrow.TextSize=16
    connect(arrow.MouseButton1Click,function() body.Visible=not body.Visible; arrow.Rotation=body.Visible and 90 or 0 end)
	table.insert(configRefresh,function() track.BackgroundColor3=S[key] and T.acc or Color3.fromRGB(45,45,55); knob.Position=S[key] and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7) end)
	connect(b.MouseButton1Click,function()
		if unsupported[key] then return end; S[key]=not S[key]; if not S[key] then restoreModule(key) end; if key=="NoParticles" then particlesApplied=false end; track.BackgroundColor3=S[key] and T.acc or Color3.fromRGB(45,45,55); knob.Position=S[key] and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7); if cb then cb(S[key]) end
	end)
	bindTip(r, name)
end

local function slider(parent,name,key,min,max,dec)
    if key=="RCSAfter" then name=name.." (not implemented)" end
	parent=settingsParent(parent,key)
	configRules[key]={min=min,max=max,dec=dec}
	local r=Instance.new("Frame",parent); r.Size=UDim2.new(1,0,0,40); r.BackgroundTransparency=1; r.LayoutOrder=nord(parent)
	local lab=Instance.new("TextLabel",r); lab.Size=UDim2.new(0.7,0,0,14); lab.BackgroundTransparency=1; lab.Text=name; lab.TextColor3=T.txt; lab.Font=Enum.Font.Gotham; lab.TextSize=12; lab.TextXAlignment=Enum.TextXAlignment.Left
	local function fmt(v) if dec>0 then return string.format("%."..dec.."f",v) end return tostring(math.floor(v+.5)) end
	local val=Instance.new("TextLabel",r); val.Size=UDim2.new(0.3,0,0,14); val.Position=UDim2.new(0.7,0,0,0); val.BackgroundTransparency=1; val.Text=fmt(S[key]); val.TextColor3=T.acc; val.Font=Enum.Font.GothamBold; val.TextSize=11; val.TextXAlignment=Enum.TextXAlignment.Right
	local bar=Instance.new("Frame",r); bar.Size=UDim2.new(1,0,0,7); bar.Position=UDim2.new(0,0,0,22); bar.BackgroundColor3=Color3.fromRGB(40,40,52); bar.BorderSizePixel=0; corner(bar,4)
	local fill=Instance.new("Frame",bar); local pct=(S[key]-min)/(max-min); fill.Size=UDim2.new(pct,0,1,0); fill.BackgroundColor3=T.acc; fill.BorderSizePixel=0; corner(fill,4)
	table.insert(configRefresh,function() fill.Size=UDim2.new(math.clamp((S[key]-min)/(max-min),0,1),0,1,0); val.Text=fmt(S[key]) end)
	local hold=false
	local function upd(x)
        if key=="RCSAfter" then return end
		local rel=math.clamp((x-bar.AbsolutePosition.X)/math.max(bar.AbsoluteSize.X,1),0,1)
		local v=min+(max-min)*rel; if dec==0 then v=math.floor(v+.5) else v=math.floor(v*10^dec+.5)/10^dec end
		S[key]=v; fill.Size=UDim2.new(rel,0,1,0); val.Text=fmt(v)
	end
	connect(bar.InputBegan,function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then hold=true; upd(i.Position.X) end end)
	connect(UIS.InputChanged,function(i) if hold and i.UserInputType==Enum.UserInputType.MouseMovement then upd(i.Position.X) end end)
	connect(UIS.InputEnded,function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then hold=false end end)
	bindTip(r, name)
end

local function drop(parent,name,key,options)
	parent=settingsParent(parent,key)
	configRules[key]={options=options}
	local r=Instance.new("Frame",parent); r.Size=UDim2.new(1,0,0,28); r.BackgroundTransparency=1; r.LayoutOrder=nord(parent)
	local lab=Instance.new("TextLabel",r); lab.Size=UDim2.new(0.5,0,1,0); lab.BackgroundTransparency=1; lab.Text=name; lab.TextColor3=T.txt; lab.Font=Enum.Font.Gotham; lab.TextSize=12; lab.TextXAlignment=Enum.TextXAlignment.Left
	local b=Instance.new("TextButton",r); b.Size=UDim2.new(0,120,0,24); b.Position=UDim2.new(1,-120,0.5,-12); b.BackgroundColor3=T.p2; b.Text=tostring(S[key]).." ▾"; b.TextColor3=T.txt; b.Font=Enum.Font.GothamBold; b.TextSize=11; corner(b,6)
	local idx=table.find(options,S[key]) or 1
	table.insert(configRefresh,function() idx=table.find(options,S[key]) or 1; b.Text=tostring(S[key]).." ▾" end)
	connect(b.MouseButton1Click,function() idx=(idx%#options)+1; S[key]=options[idx]; if key=="LockPart" then S.HeadOnly=(S[key]=="Head"); for _,refresh in ipairs(configRefresh) do pcall(refresh) end end; b.Text=tostring(S[key]).." ▾" end)
	bindTip(r, name)
end

local function keybind(parent,name,setFn,defaultText,configKey)
	parent=settingsParent(parent,configKey)
	local r=Instance.new("Frame",parent); r.Size=UDim2.new(1,0,0,28); r.BackgroundTransparency=1; r.LayoutOrder=nord(parent)
	local lab=Instance.new("TextLabel",r); lab.Size=UDim2.new(0.5,0,1,0); lab.BackgroundTransparency=1; lab.Text=name; lab.TextColor3=T.txt; lab.Font=Enum.Font.Gotham; lab.TextSize=12; lab.TextXAlignment=Enum.TextXAlignment.Left
	local b=Instance.new("TextButton",r); b.Size=UDim2.new(0,120,0,24); b.Position=UDim2.new(1,-120,0.5,-12); b.BackgroundColor3=T.p2; b.Text=defaultText; b.TextColor3=T.acc; b.Font=Enum.Font.GothamBold; b.TextSize=11; corner(b,6)
	local listen=false
	if configKey then table.insert(configRefresh,function() listen=false; bindingCapture=false; b.Text=S[configKey].Name end) end
	connect(b.MouseButton1Click,function()
        if cancelCapture then cancelCapture() end
        listen=true; bindingCapture=true; b.Text="..."
        cancelCapture=function() listen=false; bindingCapture=false; b.Text=configKey and S[configKey].Name or defaultText end
    end)
	connect(UIS.InputBegan,function(i)
		if not listen then return end
        if configKey=="PanicKey" and i.UserInputType~=Enum.UserInputType.Keyboard then return end
        if i.KeyCode==Enum.KeyCode.Escape then listen=false; b.Text=configKey and S[configKey].Name or defaultText; task.defer(function() bindingCapture=false end); return end
		if i.UserInputType==Enum.UserInputType.Keyboard then listen=false; b.Text=i.KeyCode.Name; setFn(i.KeyCode,false); task.defer(function() bindingCapture=false end)
		elseif i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.MouseButton2 then listen=false; b.Text=i.UserInputType.Name; setFn(i.UserInputType,true); task.defer(function() bindingCapture=false end) end
	end)
	bindTip(r, name)
end

local function btn(parent,name,fn,danger)
	local r=Instance.new("Frame",parent); r.Size=UDim2.new(1,0,0,32); r.BackgroundTransparency=1; r.LayoutOrder=nord(parent)
	local b=Instance.new("TextButton",r); b.Size=UDim2.new(1,0,1,0); b.BackgroundColor3=danger and T.bad or T.p2; b.Text=name; b.TextColor3=T.txt; b.Font=Enum.Font.GothamBold; b.TextSize=12; corner(b,8)
	connect(b.MouseButton1Click,fn)
	bindTip(r, name)
end

