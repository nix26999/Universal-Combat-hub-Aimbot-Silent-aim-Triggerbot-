local cats={
	{id="aim",n="Aim",d="Lock, assist, filters, humanize"},
	{id="rage",n="Rage",d="Hitbox, aura, force head, taps"},
	{id="legit",n="Legit",d="Recoil, spread, weapon helpers"},
	{id="visuals",n="Visuals",d="ESP, radar, hit markers"},
	{id="move",n="Move",d="Speed, fly, dash, parkour"},
	{id="player",n="Player",d="God, ammo, spin, anti-aim"},
	{id="world",n="World",d="Lighting, FOV, freecam"},
	{id="util",n="Util",d="Server, panic, watermark"},
	{id="social",n="Social",d="Chat and emote tools"},
	{id="config",n="Configs",d="Save, load, import, export and reset profiles"},
}
local pages, sideBtns, cur, ord = {}, {}, nil, {}
local function nord(p) ord[p]=(ord[p] or 0)+1; return ord[p] end

for i,c in ipairs(cats) do
	local b=Instance.new("TextButton",Side); b.Size=UDim2.new(1,0,0,32); b.BackgroundColor3=T.p2; b.BackgroundTransparency=1; b.Text=""; b.LayoutOrder=i; corner(b,8)
	local lab=Instance.new("TextLabel",b); lab.Name="L"; lab.Size=UDim2.new(1,-12,1,0); lab.Position=UDim2.new(0,10,0,0); lab.BackgroundTransparency=1; lab.Text=c.n; lab.TextColor3=T.dim; lab.Font=Enum.Font.GothamMedium; lab.TextSize=13; lab.TextXAlignment=Enum.TextXAlignment.Left
	sideBtns[c.id]=b
	local page=Instance.new("Frame",Scroll); page.Name=c.id; page.Size=UDim2.new(1,0,0,0); page.AutomaticSize=Enum.AutomaticSize.Y; page.BackgroundTransparency=1; page.Visible=false; page.LayoutOrder=1
	local pl=Instance.new("UIListLayout",page); pl.Padding=UDim.new(0,10); pl.SortOrder=Enum.SortOrder.LayoutOrder
	pages[c.id]=page
	connect(b.MouseButton1Click,function()
		cur=c.id; PageTitle.Text=c.n; PageDesc.Text=c.d
		for id,pg in pairs(pages) do pg.Visible=(id==c.id) end
		for id,btn in pairs(sideBtns) do
			local on=id==c.id; btn.BackgroundTransparency=on and 0 or 1; btn.BackgroundColor3=T.p2; btn.L.TextColor3=on and T.txt or T.dim
		end
	end)
end
Side.CanvasSize=UDim2.new(0,0,0,#cats*36+20)

local function card(page,title,sub)
	local c=Instance.new("Frame",page); c.Size=UDim2.new(1,0,0,0); c.AutomaticSize=Enum.AutomaticSize.Y; c.BackgroundColor3=T.card; c.BorderSizePixel=0; c.LayoutOrder=nord(page); corner(c,10); stroke(c)
	local p=Instance.new("UIPadding",c); p.PaddingTop=UDim.new(0,10); p.PaddingBottom=UDim.new(0,10); p.PaddingLeft=UDim.new(0,12); p.PaddingRight=UDim.new(0,12)
	local l=Instance.new("UIListLayout",c); l.Padding=UDim.new(0,6); l.SortOrder=Enum.SortOrder.LayoutOrder
	local h=Instance.new("TextLabel",c); h.Size=UDim2.new(1,0,0,16); h.BackgroundTransparency=1; h.Text=title; h.TextColor3=T.txt; h.Font=Enum.Font.GothamBold; h.TextSize=13; h.TextXAlignment=Enum.TextXAlignment.Left; h.LayoutOrder=0
	if sub then local s=Instance.new("TextLabel",c); s.Size=UDim2.new(1,0,0,12); s.BackgroundTransparency=1; s.Text=sub; s.TextColor3=T.mut; s.Font=Enum.Font.Gotham; s.TextSize=10; s.TextXAlignment=Enum.TextXAlignment.Left; s.LayoutOrder=0 end
	local d=Instance.new("Frame",c); d.Size=UDim2.new(1,0,0,1); d.BackgroundColor3=T.stroke; d.BorderSizePixel=0; d.LayoutOrder=1
	return c
end

